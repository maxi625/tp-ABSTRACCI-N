from abc import ABC, abstractmethod

class figura(ABC):
    @abstractmethod
    def calcular_area(self):
        pass
  
class circulo(figura):
    def calcular_area(self):
        return "area del círculo = 28.27 unidades (aproximadamente)"
        
class rectangulo(figura):
    def calcular_area(self):
        return "area del rectángulo = 20 unidades "

e1 = circulo()
print(e1.calcular_area())

e2 = rectangulo()
print(e2.calcular_area())
